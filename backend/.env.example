# Razorpay API Credentials (Test Mode - starts with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Google Gemini API Credentials
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# LangSmith Observability & Tracing (Optional for local dev, recommended for judges)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=razorrecover-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Application Settings
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./recovery.db
SYNC_DATABASE_URL=sqlite:///./recovery.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Policy Defaults
MAX_RETRIES_PER_TXN=3
COOLDOWN_HOURS=24
HIGH_VALUE_HITL_THRESHOLD_INR=50000
MIN_RECOVERY_PROBABILITY=0.15
